<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <!-- 顶栏：应用名 + 语言切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/language"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/segment_bg"
            android:contentDescription="@string/language_group"
            android:orientation="horizontal"
            android:padding="3dp">

            <RadioButton
                android:id="@+id/lang_en"
                style="@style/Segment"
                android:text="@string/lang_en" />

            <RadioButton
                android:id="@+id/lang_zh"
                style="@style/Segment"
                android:text="@string/lang_zh" />
        </RadioGroup>
    </LinearLayout>

    <!-- 状态：读屏会主动播报 -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:textColor="@color/text_dim"
        android:textSize="16sp" />

    <!-- 字幕区：上一句完整的话（读屏播报）+ 正在说的话（不播报） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_bg"
        android:minHeight="96dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empty_hint"
            android:textColor="@color/text_dim"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/last_sentence"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/partial"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/accent"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- 历史记录 -->
    <TextView
        android:id="@+id/history_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:text="@string/history"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/history_scroll"
        android:defaultFocusHighlightEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 次要操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copy"
            style="@style/Action"
            android:text="@string/copy" />

        <Button
            android:id="@+id/share"
            style="@style/Action"
            android:layout_marginHorizontal="8dp"
            android:text="@string/share" />

        <Button
            android:id="@+id/clear"
            style="@style/Action"
            android:text="@string/clear" />
    </LinearLayout>

    <!-- 状态条：听写由机身左侧的 AI 键开始/停止，这里只显示状态（不可点击） -->
    <LinearLayout
        android:id="@+id/key_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginVertical="12dp"
        android:background="@drawable/mic_idle_bg"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/key_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_mic" />

        <TextView
            android:id="@+id/key_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/key_start"
            android:textColor="@color/on_mic_idle"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
