<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PomTumAsr" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 语言切换的分段按钮 -->
    <style name="Segment">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">84dp</item>
        <item name="android:button">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:background">@drawable/segment_item_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次要操作按钮：纯文字，至少 52dp 高 -->
    <style name="Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/action_bg</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
